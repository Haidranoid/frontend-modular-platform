{
  "extends": "./tsconfig.base.json",
  "ts-node": {
    "esm": false,
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "node"
    }
  },
  "compilerOptions": {
    "types": [
      "@testing-library/jest-dom",
      "jest"
    ],
    "typeRoots": [
      "./src/@types",
      "node_modules/@types"
    ]
  },
  "include": [
    "utils",
    "src",
    "webpack.config.ts",
    "jest.config.ts",
    "jest.setup.ts",
  ],
  "exclude": [
    "cypress.config.ts",
    "cypress",
    "node_modules",
    "dist",
    "build",
    "server",
    "coverage",
    "public",
    ".idea",
    "alias.mappings.json",
    "src/main/experimental" // temporal
  ],
}

