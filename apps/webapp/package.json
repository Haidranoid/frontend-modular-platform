{
  "name": "@apps/webapp",
  "version": "0.0.0",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "private": true,
  "keywords": [],
  "author": "martinezlara_joseeduardo@hotmail.com",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "webpack serve --env mode=development",
    "lint": "linterx src/**/* .storybook/** --fix",
    "server": "java -Dspring.profiles.active=dev -Dserver.port=8080 -jar server/api.jar",
    "dev": "concurrently -k \"npm run server \" \"wait-on http://localhost:8080/api/actuator/health && npm start\"",
    "stop": "(pkill -f webpack && pkill -f node && pkill -f java) || (taskkill /IM node.exe /F & taskkill /IM java.exe /F)",
    "build": "webpack --env mode=production",
    "see": " webpack --env mode=production --json > stats.json",
    "analyze": "cross-env ANALYZE=true webpack --env mode=production",
    "test": "exit 0",
    "test:ci": "testx --ci --detectOpenHandles --forceExit",
    "test:watch": "testx --detectOpenHandles --watch",
    "test:generate-output": "testx --json --outputFile=.jest-test-results.json || true",
    "test:clean": "testx --clearCache",
    "cy": "cypress open",
    "cy:run": "cross-env NODE_ENV=cy cypress run --browser electron",
    "cy:start": "rushx storybook & wait-on http://localhost:6006 && rushx cy:run",
    "cy:open": "cypress open",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@babel/runtime": "7.28.4",
    "@reduxjs/toolkit": "2.11.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-redux": "9.2.0",
    "react-router": "7.9.3",
    "react-hook-form": "7.64.0",
    "redux": "5.0.1",
    "styled-components": "6.1.19"
  },
  "devDependencies": {
    "@webapp/shared": "workspace:*",
    "@webapp/auth": "workspace:*",
    "@webapp/users": "workspace:*",
    "@configs/typescript": "workspace:*",
    "@tools/eslint-scripts": "workspace:*",
    "@faker-js/faker": "10.0.0",
    "@jest/globals": "30.2.0",
    "@storybook/addon-a11y": "9.1.10",
    "@storybook/addon-essentials": "9.0.0-alpha.12",
    "@storybook/addon-interactions": "9.0.0-alpha.10",
    "@storybook/addon-jest": "9.1.10",
    "@storybook/addon-themes": "9.1.10",
    "@storybook/addon-webpack5-compiler-swc": "4.0.1",
    "@storybook/preview-api": "9.0.0-alpha.1",
    "@storybook/react": "9.1.10",
    "@storybook/react-webpack5": "9.1.10",
    "@storybook/test-runner": "0.23.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "msw": "2.11.3",
    "msw-storybook-addon": "2.0.5",
    "storybook": "9.1.10",
    "@babel/core": "7.28.4",
    "@babel/plugin-transform-runtime": "7.28.3",
    "@babel/preset-env": "7.28.3",
    "@babel/preset-react": "7.27.1",
    "@babel/preset-typescript": "7.27.1",
    "@types/dotenv-webpack": "7.0.8",
    "@types/node": "24.6.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/webpack": "5.28.5",
    "@types/webpack-bundle-analyzer": "4.7.0",
    "babel-loader": "10.0.0",
    "buffer": "6.0.3",
    "clean-webpack-plugin": "4.0.0",
    "compression-webpack-plugin": "11.1.0",
    "concurrently": "9.2.1",
    "copy-webpack-plugin": "13.0.1",
    "cross-env": "10.1.0",
    "css-loader": "7.1.2",
    "css-minimizer-webpack-plugin": "7.0.2",
    "dotenv-webpack": "8.1.1",
    "html-webpack-plugin": "5.6.4",
    "mini-css-extract-plugin": "2.9.4",
    "node-polyfill-webpack-plugin": "4.1.0",
    "path-browserify": "1.0.1",
    "rimraf": "6.0.1",
    "terser-webpack-plugin": "5.3.14",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "5.9.3",
    "wait-on": "9.0.1",
    "webpack": "5.102.0",
    "webpack-bundle-analyzer": "4.10.2",
    "webpack-cli": "6.0.1",
