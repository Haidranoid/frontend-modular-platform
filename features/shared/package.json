{
  "name": "@webapp/shared",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "main": "dist/commonjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/esm/index.d.mts",
  "sideEffects": false,
  "files": ["dist"],
  "typesVersions": {
    "*": {
      ".": ["./dist/esm/index.d.mts"],
      "./testing-utils/*": ["./dist/esm/index.d.mts"],
      "./browser": ["./dist/browser/index.d.mts"],
      "./node": ["./dist/node/index.d.cts"]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/commonjs/index.d.cts",
        "default": "./dist/commonjs/index.cjs"
      }
    },
    "./testing-utils/*": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/testing-utils/*"
      },
      "require": {
        "types": "./dist/commonjs/index.d.cts",
        "default": "./dist/commonjs/testing-utils/*"
      }
    },
    "./browser": {
      "browser": {
        "types": "./dist/browser/index.d.mts",
        "default": "./dist/browser/index.mjs"
      },
      "import": {
        "types": "./dist/browser/index.d.mts",
        "default": "./dist/browser/index.mjs"
      },
      "require": {
        "types": "./dist/browser/index.d.cts",
        "default": "./dist/browser/index.cjs"
      },
      "default": {
        "types": "./dist/browser/index.d.mts",
        "default": "./dist/browser/index.mjs"
      }
    },
    "./node": {
      "node": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/node/index.cjs"
      },
      "import": {
        "types": "./dist/node/index.d.mts",
        "default": "./dist/node/index.mjs"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/node/index.cjs"
      },
      "default": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/node/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "buildx",
    "build:watch": "buildx --watch",
    "lint": "linterx src/**/* .storybook/** --fix",
    "test": "testx --detectOpenHandles",
    "test:ci": "testx --detectOpenHandles",
    "test:watch": "testx --detectOpenHandles --watch",
    "test:generate-output": "testx --json --outputFile=.jest-test-results.json || true",
    "test:generate-output:watch": "rushx test:generate-output -- --watch",
    "test:clean": "testx --clearCache",
    "storybook": "storybook dev -p 6006",
    "prebuild:storybook": "rushx test:generate-output",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@configs/env": "workspace:*",
    "@configs/typescript": "workspace:*",
    "@tools/jest-scripts": "workspace:*",
    "@tools/eslint-scripts": "workspace:*",
    "@tools/rollup-scripts": "workspace:*",
    "@babel/runtime": "7.28.4",
    "@faker-js/faker": "10.0.0",
    "@jest/globals": "30.1.2",
    "@reduxjs/toolkit": "2.9.0",
    "@storybook/addon-a11y": "9.1.8",
    "@storybook/addon-essentials": "9.0.0-alpha.12",
    "@storybook/addon-interactions": "9.0.0-alpha.10",
    "@storybook/addon-jest": "9.1.8",
    "@storybook/addon-themes": "9.1.8",
    "@storybook/addon-webpack5-compiler-swc": "4.0.1",
    "@storybook/preview-api": "9.0.0-alpha.1",
    "@storybook/react": "9.1.8",
    "@storybook/react-webpack5": "9.1.8",
    "@storybook/test-runner": "0.23.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.18.0",
    "@types/react": "19.1.14",
    "@types/react-dom": "19.1.9",
    "@types/redux-logger": "3.0.13",
    "axios": "1.12.2",
    "query-string": "7.1.3",
    "jest": "30.1.3",
    "jest-fixed-jsdom": "0.0.10",
    "msw": "2.11.3",
    "msw-storybook-addon": "2.0.5",
    "path-browserify": "1.0.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-rnd": "10.5.2",
    "react-redux": "9.2.0",
    "react-router": "7.9.3",
    "redux": "5.0.1",
    "redux-logger": "3.0.6",
    "rimraf": "6.0.1",
    "storybook": "9.1.8",
    "styled-components": "6.1.19",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "tslib": "2.8.1",
    "typescript": "5.9.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
