  "description": "",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "imports": {
    "#assets": "./src/assets/index.ts",
    "#config": "./src/config/index.ts",
    "#constants":  "./src/constants/index.ts",
    "#experimental": "./src/experimental/index.ts",
    "#providers": "./src/providers/index.ts",
    "#routes":"./src/routes/index.ts",
    "#state": "./src/state/index.ts",
    "#styles": "./src/styles/index.ts",
    "#types": "./src/types/index.ts",
    "#ui": "./src/ui/index.ts",
    "#utils": "./src/utils/index.ts"
  },
  "scripts": {
    "build": "buildx",
    "lint": "linterx src/**/* msw-handlers/**/* .storybook/** --fix",
    "test": "testx --detectOpenHandles",
    "test:ci": "testx --detectOpenHandles",
    "test:watch": "testx --detectOpenHandles --watch",
    "test:clean": "testx --clearCache",
    "cy": "cypress open",
    "cy:run": "cypress run --browser electron",
    "cy:start": "rushx storybook & wait-on http://localhost:6006 && rushx cy:run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@webapp/shared": "workspace:*"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": "2.8.2"
  },
  "devDependencies": {
    "@configs/typescript": "workspace:*",
