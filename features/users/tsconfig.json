{
  "extends": "@configs/typescript/tsconfig.react.json",
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "#assets/*": ["assets/*"],
      "#config/*": ["config/*"],
      "#constants": ["constants/index.ts"],
      "#experimental": ["experimental/index.ts"],
      "#router": ["router/index.ts"],
      "#state": ["state/index.ts"],
      "#types": ["types/index.ts"],
      "#ui": ["ui/index.ts"],
      "#utils": ["utils/index.ts"]
    }
  },
  "include": ["src"]
}
